# Demo / lab only — see module docstrings for disclaimers.
# HEADLESS=1
# After pip install: playwright install chromium
# JSON from: python -m expedia_listing_cli extract-filters --url "https://..." -o catalog.json
# Merges golden query params into `url` / `fetch` builds (Travel Planner can point here too).
# EXPEDIA_HOTEL_SEARCH_CATALOG_JSON=./expedia_hotel_search_catalog.json
# Optional: full hotel search URL from your browser (overrides url-build)
# EXPEDIA_HOTEL_SEARCH_URL=https://www.expedia.com/...
# Browser-shaped build: copy regionId from a working Hotel-Search URL in DevTools
# EXPEDIA_REGION_ID=2008
# Optional session id from the same URL (may expire)
# EXPEDIA_TYPEAHEAD_COLLATION_ID=f3bfefe9-64bb-4019-9169-c3cf60b5995d
# BROWSER_TIMEOUT_MS=90000
# After domcontentloaded, wait this many ms for React/hydration (default 3000). Expedia rarely hits networkidle.
# BROWSER_SETTLE_MS=3000
# /Flights-Search only: poll page HTML until a $ fare appears (PWA hydration); step between reads.
# BROWSER_FLIGHT_POLL_MS=60000
# BROWSER_FLIGHT_POLL_STEP_MS=2000
# /Flights-Search only: if poll budget ends without a $ fare token, stay in the same browser tab this many
# extra waits (reduces need for a second full Playwright launch in Wanderly ``BOOKING_SEARCH_RETRY_WEAK_FETCH``).
# BROWSER_FLIGHT_LINGER_ROUNDS=6
# BROWSER_FLIGHT_LINGER_MS=3000
# /Hotel-Search only: poll HTML until listing-shaped markers appear (mirrors flight polling).
# BROWSER_HOTEL_POLL_MS=60000
# BROWSER_HOTEL_POLL_STEP_MS=2000
# Set to 1 to use Playwright networkidle again (often hangs 8–20s+ on OTA sites)
# BROWSER_WAIT_NETWORKIDLE=0
# BROWSER_NETWORKIDLE_MS=8000
# OUTPUT_DIR=.cache
