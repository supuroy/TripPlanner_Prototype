# Copy to project root as `.env` or to `config/.env` (both are loaded).
# Create keys: https://cursor.com/dashboard/integrations (Cloud Agents)

CURSOR_API_KEY=

# Required for Cloud Agents: HTTPS URL of a repo the Cursor GitHub app can access.
# GitHub.com or GitHub Enterprise — GHES must be registered under Dashboard →
# Integrations → Advanced → GitHub Enterprise Server (private repos are OK if the app can access them).
# Debug: python hello_cursor_api.py --list-repos
CURSOR_REPO_URL=https://github.com/your-org/your-repo

# Optional: branch / tag / commit for Cloud Agents. If unset, the script sends "main"
# explicitly (avoids API errors when GitHub default-branch lookup fails).
# Set to master, develop, etc. if your default branch is not main.
# CURSOR_REPO_REF=main

# Optional: base model id from GET /v1/models (e.g. gpt-5.2). If unset, the first
# variant with isDefault=true is used (includes variant params when required).
# CURSOR_MODEL_ID=

# Wanderly: reuse one Cloud Agent per session (follow-up runs). 0/false/no/off = always new agent.
# CURSOR_REUSE_AGENT=1
# Wanderly mid-tier refine + structured Q&A (see Travel Planner Prototype/.env.example)
# CURSOR_REFINEMENT_MODEL_ID=

# --- Wanderly hero images (optional; see Travel Planner Prototype/.env.example) ---
# WANDERLY_HERO_IMAGE_LOG=0
# UNSPLASH_ACCESS_KEY=
