# Leave empty to use Vite dev proxy to Python on http://127.0.0.1:8000 (see vite.config.ts).
# Or set full origin, e.g. http://127.0.0.1:8000
VITE_API_BASE=

# First planning turn: use full orchestrator (/api/wanderly/plan) instead of Wanderly smoke_turn (both use Cursor on server).
# VITE_USE_GEMINI_FIRST=true

# Poll GET /api/wanderly/workspace while enrichment_pending (orchestrator enrichment path).
# VITE_POLL_WORKSPACE=true
#
# Parallel background itinerary HTTP (one queue + Cursor lane per destination). Requires Python
# ``WANDERLY_ITINERARY_PARALLEL_DEST=1`` on the Travel Planner server.
VITE_WANDERLY_ITINERARY_PARALLEL_DEST=1
