# Cursor Cloud Agents (all planner LLM + Wanderly smoke/refine)
CURSOR_API_KEY=
# Reuse one Cloud Agent per Wanderly session (follow-up runs) instead of POST /v1/agents every time.
# Set to 0/false/no/off to always create a fresh agent (previous behavior).
# CURSOR_REUSE_AGENT=1
#
# Lazy itinerary (build_itinerary / stream): console + ``Travel Planner Prototype/.cache/itinerary_debug.log``
# WANDERLY_ITIN_LOG=1
# Verbose: log raw model text head when normalization yields zero days (no PII beyond destination id)
# WANDERLY_ITIN_DEBUG=1
#
# Parallel lazy itinerary: one Cursor persistence lane per destination (higher throughput / cost).
# Must match the Figma app: ``VITE_WANDERLY_ITINERARY_PARALLEL_DEST=1`` or builds still serialize in the browser.
# WANDERLY_ITINERARY_PARALLEL_DEST=1
#
# HTTPS GitHub URL visible to the Cursor GitHub app
CURSOR_REPO_URL=https://github.com/your-org/your-repo
# Optional
# CURSOR_REPO_REF=main
# CURSOR_MODEL_ID=
#
# Model tiers (ids from GET /v1/models):
# - Mid-tier refinement: refine chat (workspace JSON), plan_review, advisor_feed, profile-change advisor JSON.
#   When unset, refine uses the full planner above; structured follow-ups fall back to advisor or skip.
# CURSOR_REFINEMENT_MODEL_ID=
# - Cheapest advisor: parallel profile listener only (fast pill extraction during smoke/refine).
# CURSOR_ADVISOR_MODEL_ID=
# Optional: lighter model id for the short hero-image search-hint JSON call (after cards exist)
# CURSOR_LIGHT_MODEL_FOR_IMAGES=
# Set to 0/false/no to skip that hint call and use "{name} {country}" only
# CURSOR_HERO_IMAGE_LLM=1
# Max hero URLs per card (slideshow); 1–6, default 3
# HERO_GALLERY_MAX=3
#
# --- Hero images (faster + higher quality than Wikimedia-only) ---
# "auto": Unsplash if UNSPLASH_ACCESS_KEY set, else Pexels if PEXELS_API_KEY, else Wikimedia only.
# TripAdvisor etc. are not used: no suitable public photo API; scraping breaks ToS and layout often.
# WANDERLY_HERO_IMAGE_SOURCE=auto
# WANDERLY_HERO_IMAGE_SOURCE=unsplash
# WANDERLY_HERO_IMAGE_SOURCE=pexels
# WANDERLY_HERO_IMAGE_SOURCE=wikimedia
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# HERO_IMAGE_FETCH_CONCURRENCY=5
# [hero_images] console logs (default on). Set 0 to disable. Also appends:
#   Travel Planner Prototype/.cache/hero_images.log
# WANDERLY_HERO_IMAGE_LOG=0
# Unsplash content_filter: low | high (default low; high can return no rows for some queries)
# UNSPLASH_CONTENT_FILTER=low
# Unsplash orientation (omit by default for broader matches). landscape | portrait | squarish
# UNSPLASH_ORIENTATION=landscape
# Pexels orientation (omit by default). landscape | portrait | square
# PEXELS_ORIENTATION=landscape
# After stock search, fill misses from Wikimedia (slower): 0|1, default 0
# HERO_IMAGE_STOCK_FALLBACK_WIKIMEDIA=0
# Gap between Wikimedia fallback calls only (seconds)
# HERO_IMAGE_REQUEST_GAP_S=0.55
# If Wikipedia/Commons return 403, set a custom UA per https://meta.wikimedia.org/wiki/User-Agent_policy
# WANDERLY_WIKIMEDIA_USER_AGENT=

# Optional: JSON cache path for structured planner calls (replay / dev)
# CURSOR_PLANNER_CACHE_PATH=.cache/cursor_planner_cache.json

# Throttle between Cursor agent runs (seconds)
# CURSOR_MIN_INTERVAL_SECONDS=2.0
# CURSOR_MAX_RETRY_ATTEMPTS=4
