# Cursor Cloud Agents (all planner LLM + Wanderly smoke/refine)
CURSOR_API_KEY=
# Reuse one Cloud Agent per Wanderly session (follow-up runs) instead of POST /v1/agents every time.
# Set to 0/false/no/off to always create a fresh agent (previous behavior).
# CURSOR_REUSE_AGENT=1
#
# Persist reused agent ids across server restarts (JSON map by session_id + lane; same client session_id
# then resumes follow-up runs on POST /v1/agents/{id}/runs). Default file: Travel Planner Prototype/.cache/cursor_agent_ids.json
# WANDERLY_CURSOR_AGENT_IDS_PERSIST=1
# Optional absolute or cwd-relative path for that JSON file
# WANDERLY_CURSOR_AGENT_IDS_PATH=.cache/cursor_agent_ids.json
#
# Persist Wanderly workspace snapshots (destination cards JSON, profile pills, planner chat, last model
# destinations) so GET /api/wanderly/workspace can restore after a server restart. Works with the same
# ``session_id`` stored in the browser (``localStorage`` key ``wanderly_session_id``).
# WANDERLY_SESSION_SNAPSHOT_PERSIST=1
# WANDERLY_SESSION_SNAPSHOT_PATH=.cache/wanderly_session_snapshots.json
# If ``sync_ui`` raises WinError 5 / PermissionError on replace (OneDrive or AV locking the JSON),
# the server retries rename then falls back to in-place write. Tune: ``WANDERLY_SNAPSHOT_REPLACE_RETRIES`` (default 18),
# ``WANDERLY_SNAPSHOT_REPLACE_DELAY_S`` (base backoff, default 0.04).
#
# On reused agents (follow-up runs), omit leading static instructions when callers pass
# ``persistent_instruction_prefix`` matching the full prompt (smaller POST body). New agents always get the full prompt.
# CURSOR_REUSE_STRIP_STATIC_INSTRUCTIONS=1
# Optional one-line override for the short reminder prepended on stripped follow-ups
# CURSOR_REUSE_FOLLOWUP_HINT=
#
# Lazy itinerary (build_itinerary / stream): console + ``Travel Planner Prototype/.cache/itinerary_debug.log``
# WANDERLY_ITIN_LOG=1
# Verbose: log raw model text head when normalization yields zero days (no PII beyond destination id)
# WANDERLY_ITIN_DEBUG=1
# Extra logistics / ``day_logistics`` merge traces (first row keys, capped raw body — dev only)
# WANDERLY_LOGISTICS_DEBUG=1
# If the first itinerary JSON has days but no persisted ``day_logistics``, run one follow-up Cursor repair pass (default on).
# WANDERLY_ITIN_LOGISTICS_RETRY=0
# Max chars of the first-pass JSON embedded in the repair prompt (default 16000).
# WANDERLY_ITIN_LOGISTICS_RETRY_MAX_PREVIOUS_CHARS=16000
#
# Parallel lazy itinerary: one Cursor persistence lane per destination (recommended for multi-card trips).
# Default is on when unset; set to 0/false/off to reuse one itinerary agent for every card (serialized builds).
# Must match the Figma app — see below — or the browser still serializes itinerary HTTP calls.
WANDERLY_ITINERARY_PARALLEL_DEST=1
#
# LLM orchestration: ``POST /api/wanderly/orchestrate`` (Figma card chat + main bar) classifies the next line
# (planner vs advisor vs explicit removal). Requires ``CURSOR_ADVISOR_MODEL_ID`` or ``CURSOR_REFINEMENT_MODEL_ID``.
#
# HTTPS GitHub URL visible to the Cursor GitHub app
CURSOR_REPO_URL=https://github.com/your-org/your-repo
# Optional
# CURSOR_REPO_REF=main
# CURSOR_MODEL_ID=
#
# Model tiers (ids from GET /v1/models):
# - Mid-tier refinement: refine chat (workspace JSON), plan_review, advisor_feed, profile-change advisor JSON.
#   When unset, refine uses the full planner above; structured follow-ups fall back to advisor or skip.
# CURSOR_REFINEMENT_MODEL_ID=
# - Cheapest advisor: parallel profile listener only (fast pill extraction during smoke/refine).
# CURSOR_ADVISOR_MODEL_ID=
#
# Card chat “Look it up (Wanderly)”: server-side web snippets + second advisor pass (optional).
# Set **one** of: ``TAVILY_API_KEY`` (recommended) or ``BRAVE_SEARCH_API_KEY`` (or legacy ``BRAVE_API_KEY``).
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# Optional: lighter model id for the short hero-image search-hint JSON call (after cards exist)
# CURSOR_LIGHT_MODEL_FOR_IMAGES=
# Set to 0/false/no to skip that hint call and use "{name} {country}" only
# CURSOR_HERO_IMAGE_LLM=1
# Max hero URLs per card (slideshow); 1–6, default 3
# HERO_GALLERY_MAX=3
#
# --- Hero images (faster + higher quality than Wikimedia-only) ---
# "auto": Unsplash if UNSPLASH_ACCESS_KEY set, else Pexels if PEXELS_API_KEY, else Wikimedia only.
# TripAdvisor etc. are not used: no suitable public photo API; scraping breaks ToS and layout often.
# WANDERLY_HERO_IMAGE_SOURCE=auto
# WANDERLY_HERO_IMAGE_SOURCE=unsplash
# WANDERLY_HERO_IMAGE_SOURCE=pexels
# WANDERLY_HERO_IMAGE_SOURCE=wikimedia
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# HERO_IMAGE_FETCH_CONCURRENCY=5
# [hero_images] console logs (default on). Set 0 to disable. Also appends:
#   Travel Planner Prototype/.cache/hero_images.log
# WANDERLY_HERO_IMAGE_LOG=0
# Unsplash content_filter: low | high (default low; high can return no rows for some queries)
# UNSPLASH_CONTENT_FILTER=low
# Unsplash orientation (omit by default for broader matches). landscape | portrait | squarish
# UNSPLASH_ORIENTATION=landscape
# Pexels orientation (omit by default). landscape | portrait | square
# PEXELS_ORIENTATION=landscape
# After stock search, fill misses from Wikimedia (slower): 0|1, default 0
# HERO_IMAGE_STOCK_FALLBACK_WIKIMEDIA=0
# Gap between Wikimedia fallback calls only (seconds)
# HERO_IMAGE_REQUEST_GAP_S=0.55
# If Wikipedia/Commons return 403, set a custom UA per https://meta.wikimedia.org/wiki/User-Agent_policy
# WANDERLY_WIKIMEDIA_USER_AGENT=

# Optional: JSON cache path for structured planner calls (replay / dev)
# CURSOR_PLANNER_CACHE_PATH=.cache/cursor_planner_cache.json

# Throttle between Cursor agent runs (seconds)
# CURSOR_MIN_INTERVAL_SECONDS=2.0
# CURSOR_MAX_RETRY_ATTEMPTS=4

# --- Phase 1: EGDP / Trino smoke (``python scripts/egdp_smoke.py`` from Travel Planner Prototype) ---
# Required for the smoke script:
# TRINO_HOST=
# TRINO_CATALOG=
# Credentials — either in .env (dev only) or HashiCorp Vault KV v2 (preferred):
# TRINO_USER=
# TRINO_PASSWORD=
#
# Vault (no password in .env): after `vault login`, store e.g. username + password at secret/egdp/trino
#   vault kv put secret/egdp/trino username=YOUR_SEA_ID password=YOUR_SECRET
# Then set (token is NOT in .env — use `vault login` or VAULT_TOKEN in the shell for this session):
# VAULT_ADDR=https://vault.your-org.example
# TRINO_VAULT_SECRET_PATH=egdp/trino
# TRINO_VAULT_KV_MOUNT=secret
# TRINO_VAULT_USER_FIELD=username
# TRINO_VAULT_PASSWORD_FIELD=password
# Optional: VAULT_NAMESPACE=...   VAULT_TOKEN_PATH=...   VAULT_CA_BUNDLE=...   VAULT_TLS_VERIFY=1
#
# Optional:
# TRINO_PORT=443
# TRINO_HTTP_SCHEME=https
# TRINO_SCHEMA=
# TRINO_REQUEST_TIMEOUT_S=120
# TLS certificate verification for HTTPS (0/false to disable — dev only)
# TRINO_TLS_VERIFY=1
# Preferred for corp cert chains: CA bundle path (overrides TRINO_TLS_VERIFY bool)
# TRINO_CA_BUNDLE=C:\path\to\corp-ca-bundle.pem
# Build a chain PEM from what the server sends (Python 3.13+): ``python scripts/trino_dump_server_chain.py <host> 8443 -o trino-server-chain.pem``
# Default query is SELECT 1 + timestamp + user; override to probe a real table (keep read-only + LIMIT)
# EGDP_SMOKE_SQL=SELECT * FROM your_catalog.your_schema.your_table LIMIT 10
# EGDP_SMOKE_ROW_LIMIT=20
# Minimal Ava-style smoke script (``python scripts/trino_smoke_basic.py``):
# TRINO_SMOKE_SQL=SELECT 1 AS test_col
# Uses the same TRINO_* + Vault KV vars as ``egdp_smoke.py`` (see Vault block above).

# --- Phase 1: Analytics Workbench smoke (``python scripts/analytics_workbench_smoke.py``) ---
# AWB GraphQL (EGAP FAQ): **metadata only** — clusters, schemas, security, LDAP, costs, etc. **Not** data-lake query results.
# For programmatic SQL use ``python scripts/egdp_smoke.py`` (Trino) or Querybook MCP; do not expect ``SELECT`` via AWB GraphQL.
#
# Expedia AWB often uses GraphQL: POST ``/api/v1/graphql`` with JSON ``{ "query", "variables", "operationName" }``.
# In DevTools → Network → graphql request → Payload: copy ``query`` (and ``variables`` / ``operationName`` if present).
#
# AWB_BASE_URL=https://analytics.expedia.biz
# AWB_ACCESS_TOKEN=
# Option A — GraphQL (defaults to POST /api/v1/graphql). Do not use GET with an empty body.
# Either omit AWB_SMOKE_PATH or set it to /api/v1/graphql **together with** AWB_GRAPHQL_QUERY_FILE (or AWB_GRAPHQL_QUERY).
# Minimal smoke:
# AWB_GRAPHQL_QUERY=query { __typename }
# AWB_GRAPHQL_VARIABLES_JSON={}
#
# Example: ``LdapUser`` (same query file; pick ONE ``where`` shape from DevTools):
# AWB_GRAPHQL_QUERY_FILE=./scripts/awb_smoke_graphql_ldap_user.graphql
# AWB_GRAPHQL_OPERATION_NAME=LdapUser
# Prefer domain + sAMAccountName when available (no full DN):
# AWB_GRAPHQL_VARIABLES_JSON={"where":{"domain_sAMAccountName":{"domain":"sea","sAMAccountName":"yourid"}}}
# Or full LDAP distinguishedName:
# AWB_GRAPHQL_VARIABLES_JSON={"where":{"distinguishedName":"CN=...,DC=com"}}
#
# Optional: require non-null GraphQL ``data`` subtree (e.g. ldapUser) or minimum list length when the field is an array:
# AWB_GRAPHQL_ASSERT_DATA_PATH=data.ldapUser
# AWB_GRAPHQL_MIN_ROWS=1
#
# Option B — arbitrary REST:
# Required path (relative to base). Must match YOUR deployment (copy from Network tab or internal docs).
# AWB_SMOKE_PATH=/api/v1/me
# AWB_SMOKE_METHOD=GET
# AWB_AUTH_MODE=bearer
# AWB_AUTH_MODE=api-access-token
# AWB_AUTH_MODE=header
# AWB_AUTH_HEADER_NAME=X-Api-Key
# Optional POST JSON body string:
# AWB_SMOKE_BODY_JSON={"query":"SELECT 1"}
# AWB_EXTRA_HEADERS_JSON={}
# AWB_REQUEST_TIMEOUT_S=120
# AWB_TLS_VERIFY=1
# Optional two-step poll (``{id}`` placeholder; only for async APIs). Omit for single-shot GraphQL like LdapUser.
# AWB_POLL_PATH_TEMPLATE=/api/v1/runs/{id}/status
# AWB_POLL_ID_JSON_PATH=data.id
# AWB_POLL_STATUS_JSON_PATH=data.status
# AWB_POLL_DONE_VALUES=DONE,SUCCEEDED,COMPLETED,success,3
# AWB_POLL_FAIL_VALUES=FAILED,ERROR,error,4
# AWB_POLL_MAX_WAIT_S=120
# AWB_POLL_INTERVAL_S=2

# --- Phase 1: Querybook smoke (``python scripts/querybook_smoke.py``) ---
# Experimental: hits OSS-shaped REST (``…/query_execution/``). Expedia FAQ: that REST surface is **not** a supported
# user API; prefer Querybook MCP (``https://querybook.expedia.biz/mcp``, Bearer token) or Trino JDBC/Python for automation.
# QUERYBOOK_BASE_URL=https://querybook.example.com
# QUERYBOOK_API_ACCESS_TOKEN=
# or: QUERYBOOK_ACCESS_TOKEN=
# EG docs: ``Authorization: Bearer <token>`` (default QUERYBOOK_TOKEN_HEADER=bearer). VPN/ZPA typically required.
# OSS-only fallback if your fork expects it: QUERYBOOK_TOKEN_HEADER=api-access-token
# ensure token is Querybook’s (not AWB); no quotes around the token in .env.
# OSS default /ds; Expedia EGAP often uses:
# QUERYBOOK_DS_PATH=/egap/ds
# QUERYBOOK_DS_PATH=/ds
# Either fixed engine or environment for discovery:
# QUERYBOOK_ENGINE_ID=123
# QUERYBOOK_ENVIRONMENT_ID=1
# QUERYBOOK_ENGINE_NAME_SUBSTR=trino
# QUERYBOOK_SMOKE_SQL=SELECT 1 AS ok, current_timestamp AS server_ts
# QUERYBOOK_REQUEST_TIMEOUT_S=120
# QUERYBOOK_TLS_VERIFY=1
# QUERYBOOK_POLL_MAX_WAIT_S=300
# QUERYBOOK_POLL_INTERVAL_S=2
# QUERYBOOK_RESULT_PREVIEW_LIMIT=20

# --- Expedia listing lab (``../expedia-listing-cli``): golden Hotel-Search filters as JSON ---
# Build once from a browser URL with filters on:
#   cd ../expedia-listing-cli && python -m expedia_listing_cli extract-filters --url "https://www.expedia.com/Hotel-Search?..." -o expedia_hotel_search_catalog.json
# Point the CLI or future Travel Planner URL builder at the file (same name as in expedia-listing-cli ``.env.example``):
# EXPEDIA_HOTEL_SEARCH_CATALOG_JSON=../expedia-listing-cli/expedia_hotel_search_catalog.json
# Note: ``ota_booking_search`` hotel URLs drop regionId, typeaheadCollationId, and semdtl from the merged catalog (optional/session fields).
# All generated Hotel-Search URLs include ``lodging=HOTEL`` (hotels only; excludes VRBO/vacation rentals).
#
# Booking search trace (JSON lines: URL, html_len, html_preview, parse heuristics). Default: Travel Planner Prototype/.cache/booking_search_trace.log
# BOOKING_SEARCH_TRACE_LOG=.cache/booking_search_trace.log
# BOOKING_SEARCH_ENABLED=1
# Advisor/structured LLM to split multi-city lodging from day-by-day itinerary when heuristics yield one stay (0=off).
# BOOKING_SEARCH_OUTLINE_LLM=1
# Advisor LLM for concrete trip start/end dates from profile When + itinerary length (off by default; falls back to rules + UI date_hints).
# BOOKING_SEARCH_DATES_LLM=1
# Advisor LLM for Expedia filter intent (stops, cabin, hotel sort/stars/amenities) after dates are fixed (default on).
# BOOKING_SEARCH_PARAM_LLM=1
# Single advisor JSON bundle: trip dates + multi-stay rows + flight/hotel filter intent from itinerary (off by default; set 1 to enable).
# BOOKING_SEARCH_UNIFIED_BUNDLE_LLM=1
# After prepare, prefetch flight + hotel SRP HTML in parallel (default on).
# BOOKING_SEARCH_PARALLEL_PREFETCH=0
# Log listing HTML focus stats (``Travel Planner Prototype/.cache/booking_listing_html_excerpt_debug.log``).
# BOOKING_SEARCH_LISTING_HTML_DEBUG=1
# Optional override path for that log.
# BOOKING_SEARCH_LISTING_HTML_DEBUG_LOG=.cache/booking_listing_html_excerpt_debug.log
# Emit ``listing_html_focus`` lines into ``BOOKING_SEARCH_TRACE_LOG`` (same ``ts`` as other booking events; can be noisy).
# BOOKING_SEARCH_TRACE_LISTING_FOCUS=1
# Include ``debug_parse`` (field source map) on each booking_search_step JSON response (browser console + server).
# BOOKING_SEARCH_API_DEBUG=1
# Playwright fetch: ../expedia-listing-cli/.env.example (BROWSER_SETTLE_MS, BROWSER_FLIGHT_*_POLL, BROWSER_HOTEL_*_POLL, BROWSER_FLIGHT_LINGER_*, networkidle)
#
# Flight URLs: default **one-way** outbound catalog links so one HTML snapshot matches outbound cards
# (round-trip SRP often hides return-leg rows until another UI step).
# BOOKING_SEARCH_FLIGHT_FORCE_ONEWAY=1
#
# Optional: Playwright HTML → Cursor LLM → flight listings + best pick (no Tavily; requires CURSOR_API_KEY).
# BOOKING_SEARCH_FLIGHT_LLM_PARSE=0
# Second Cursor pass (``structured_followup_model_id``: refinement/advisor tier) to re-rank listings vs profile.
# BOOKING_SEARCH_FLIGHT_ADVISOR_RANK=0
# Max chars of Playwright HTML excerpt sent to the model (default 90000)
# BOOKING_SEARCH_FLIGHT_LLM_MAX_INPUT_CHARS=90000
# Optional lighter model id for this short JSON call
# CURSOR_LIGHT_MODEL_FOR_FLIGHT_LIST=
#
# Same pattern for hotels (Playwright HTML → LLM; optional advisor rerank).
# BOOKING_SEARCH_HOTEL_LLM_PARSE=0
# BOOKING_SEARCH_HOTEL_ADVISOR_RANK=0
# After hotel LLM parse, pick the winner with nightly-band rule scoring (default on). Set 0 to use parse best_index + advisor rerank only.
# BOOKING_SEARCH_HOTEL_RULE_PICK=1
# Verbose terminal: print each candidate score + winner when rule-picking (set 1 while tuning).
# BOOKING_SEARCH_HOTEL_RULE_PICK_LOG=1
# Append rule-pick blocks, hotel-step checkpoint, and [hotel_final] (which path produced the card; default on). Default: Travel Planner Prototype/.cache/hotel_rule_pick.log
# BOOKING_SEARCH_HOTEL_RULE_PICK_FILE=1
# Optional path (relative paths are under Travel Planner Prototype/). Do not put spaces before the variable name.
# BOOKING_SEARCH_HOTEL_RULE_PICK_LOG_PATH=.cache/hotel_rule_pick.log
# BOOKING_SEARCH_HOTEL_LLM_MAX_INPUT_CHARS=90000
# Save raw hotel SRP HTML after each fetch to ``Travel Planner Prototype/.cache/hotel_debug_html/`` (reuse for offline parsing tests).
# BOOKING_SEARCH_HOTEL_DEBUG_SAVE_HTML=0
# Offline dev: fetch once, then iterate on parsers without Playwright:
#   python scripts/debug_hotel_fetch_html.py --url "https://www.expedia.com/Hotel-Search?..." --save-html .cache/hotel_srp.html
#   python scripts/debug_hotel_fetch_html.py --input-html .cache/hotel_srp.html --url "…same URL…" --excerpt .cache/hotel_excerpt.html
#
# Hotel-Search URL ``price=`` min/max vs traveler budget (default ``wide``):
# - wide — loosen bounds sent to Expedia so SRPs still show listings; tight nightly intent stays for ranking/heuristic.
# - strict — pass intent min/max unchanged (old behavior; narrow filters can return empty SRPs).
# - off — omit ``price=`` from the URL (broadest inventory; budget only in ranking / parsing).
# BOOKING_HOTEL_PRICE_URL_MODE=wide
# CURSOR_LIGHT_MODEL_FOR_HOTEL_LIST=
